{%- liquid
  assign link_text = block.settings.link_text | default: 'Size guide'
  assign style_class = 'size-guide-button--' | append: block.settings.button_style
  assign button_color = block.settings.button_color | default: '#008060'
  assign text_color = block.settings.text_color | default: '#ffffff'
  assign display_mode = block.settings.display_mode | default: 'button'
  assign border_radius = block.settings.border_radius | default: 4
  assign button_padding = block.settings.button_padding | default: 14
  assign full_width = block.settings.full_width | default: false
  assign modal_max_width = block.settings.modal_max_width | default: 720
  assign font_family = block.settings.font_family | default: 'system-ui'
  assign dark_mode = block.settings.dark_mode | default: false
-%}

<div class="size-guide-button-wrapper size-guide-button-wrapper--{{ block.settings.alignment }}{% if dark_mode %} size-guide-button-wrapper--dark{% endif %}" style="--sg-font: {{ font_family }}; --modal-max-width: {{ modal_max_width }}px;">
  {%- if display_mode == 'inline' -%}
    <div class="size-guide-inline" data-size-guide-inline
      data-shop="{{ shop.permanent_domain }}"
      data-product-type="{{ product.type | escape }}"
      data-product-tags="{{ product.tags | join: ',' | escape }}"
      data-product-handle="{{ product.handle | escape }}"
      data-collection-handles="{% for collection in product.collections %}{{ collection.handle }}{% unless forloop.last %},{% endunless %}{% endfor %}"
      data-logged-in-customer-id="{{ customer.id | default: '' }}"
      data-customer-tags="{{ customer.tags | join: ',' | escape }}"
      data-product-price="{{ product.selected_or_first_available_variant.price | money_without_currency }}"
      data-product-available="{{ product.selected_or_first_available_variant.available }}"
      data-app-proxy-url="{{ shop.url }}/apps/size-guide">
      <p class="size-guide-inline__loading">Loading size guide...</p>
    </div>
  {%- else -%}
    <button type="button" class="size-guide-button {{ style_class }}{% if full_width %} size-guide-button--full{% endif %}" data-size-guide-open
      data-shop="{{ shop.permanent_domain }}"
      data-product-type="{{ product.type | escape }}"
      data-product-tags="{{ product.tags | join: ',' | escape }}"
      data-product-handle="{{ product.handle | escape }}"
      data-collection-handles="{% for collection in product.collections %}{{ collection.handle }}{% unless forloop.last %},{% endunless %}{% endfor %}"
      data-logged-in-customer-id="{{ customer.id | default: '' }}"
      data-customer-tags="{{ customer.tags | join: ',' | escape }}"
      data-product-price="{{ product.selected_or_first_available_variant.price | money_without_currency }}"
      data-product-available="{{ product.selected_or_first_available_variant.available }}"
      data-app-proxy-url="{{ shop.url }}/apps/size-guide"
      style="--btn-color: {{ button_color }}; --btn-bg: {{ button_color }}; --btn-text: {{ text_color }}; --btn-radius: {{ border_radius }}px; --btn-padding: {{ button_padding }}px;"
      aria-label="{{ link_text }}">
      {{ link_text }}
    </button>
  {%- endif -%}
</div>

<div class="size-guide-modal hidden" data-size-guide-modal role="dialog" aria-label="Size guide">
  <div class="size-guide-modal__overlay" data-size-guide-close></div>
  <div class="size-guide-modal__content">
    <button type="button" class="size-guide-modal__close" data-size-guide-close aria-label="{{ 'general.accessibility.close' | t }}">&times;</button>
    <div data-size-guide-content class="size-guide-modal__body">
      <p>{{ 'size_guide.loading' | t }}</p>
    </div>
  </div>
</div>

<style>
.size-guide-button-wrapper { display: flex; margin: 12px 0; }
.size-guide-button-wrapper--left { justify-content: flex-start; }
.size-guide-button-wrapper--center { justify-content: center; }
.size-guide-button-wrapper--right { justify-content: flex-end; }

.size-guide-inline { width: 100%; }
.size-guide-inline__loading { color: #6b7280; font-size: 14px; }

.size-guide-button {
  --btn-color: #008060;
  --btn-bg: #008060;
  --btn-text: #ffffff;
  --btn-radius: 4px;
  --btn-padding: 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  font: inherit;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.2;
  cursor: pointer;
  border: none;
  border-radius: var(--btn-radius);
  padding: var(--btn-padding) calc(var(--btn-padding) * 1.4);
  transition: opacity 0.2s ease, transform 0.1s ease, box-shadow 0.2s ease;
}
.size-guide-button--full { width: 100%; }
.size-guide-button:hover { opacity: 0.9; }
.size-guide-button:active { transform: translateY(1px); }

.size-guide-button--primary {
  background-color: var(--btn-bg);
  color: var(--btn-text);
}
.size-guide-button--secondary {
  background-color: transparent;
  color: var(--btn-color);
  box-shadow: inset 0 0 0 2px var(--btn-color);
}
.size-guide-button--link {
  background-color: transparent;
  color: var(--btn-color);
  text-decoration: underline;
  padding: 0;
}

.size-guide-modal {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.size-guide-modal.hidden { display: none; }
.size-guide-modal__overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(2px);
}
.size-guide-modal__content {
  position: relative;
  background: #fff;
  border-radius: 12px;
  max-width: var(--modal-max-width, 720px);
  width: calc(100% - 32px);
  max-height: 85vh;
  overflow: auto;
  box-shadow: 0 10px 40px rgba(0,0,0,0.25);
}
.size-guide-button-wrapper--dark .size-guide-modal__content { background: #0f172a; color: #e5e7eb; }
@media (prefers-color-scheme: dark) {
  .size-guide-button-wrapper--dark .size-guide-modal__content { background: #0f172a; color: #e5e7eb; }
}
.size-guide-modal__close {
  position: absolute;
  top: 12px;
  right: 16px;
  background: none;
  border: none;
  font-size: 24px;
  cursor: pointer;
  line-height: 1;
  z-index: 1;
}
.size-guide-modal__body { padding: 32px 24px 24px; }
.size-guide__title { margin-top: 0; font-size: 20px; }
.size-guide__unit { color: #6b7280; margin-bottom: 12px; }
.size-guide__table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 14px; }
.size-guide__table th, .size-guide__table td { border: 1px solid #e5e7eb; padding: 10px 8px; text-align: center; }
.size-guide__table th { background: #f9fafb; font-weight: 600; }
.size-guide__table tr:nth-child(even) { background: #fafafa; }
</style>

<script src="{{ 'size-guide.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Size guide button",
  "target": "section",
  "settings": [
    {
      "type": "select",
      "id": "display_mode",
      "label": "Display mode",
      "options": [
        { "value": "button", "label": "Button (opens modal)" },
        { "value": "inline", "label": "Inline (shows on page load)" }
      ],
      "default": "button"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Size guide"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary outline" },
        { "value": "link", "label": "Text link" }
      ],
      "default": "primary"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#008060"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "default": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_padding",
      "label": "Button padding",
      "min": 8,
      "max": 30,
      "step": 2,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width button",
      "default": false
    },
    {
      "type": "range",
      "id": "modal_max_width",
      "label": "Modal max width",
      "min": 320,
      "max": 900,
      "step": 20,
      "default": 720,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "font_family",
      "label": "Font family",
      "default": "system-ui",
      "info": "e.g. Inter, Poppins, Georgia"
    },
    {
      "type": "checkbox",
      "id": "dark_mode",
      "label": "Dark mode",
      "default": false,
      "info": "Use dark background for the modal"
    }
  ]
}
{% endschema %}
