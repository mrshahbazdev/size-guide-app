{%- liquid
  assign link_text = block.settings.link_text | default: 'Find my size'
  assign style_class = 'fit-finder-button--' | append: block.settings.button_style
  assign display_mode = block.settings.display_mode | default: 'page'
  assign button_color = block.settings.button_color | default: '#008060'
  assign text_color = block.settings.text_color | default: '#ffffff'
  assign border_radius = block.settings.border_radius | default: 4
  assign button_padding = block.settings.button_padding | default: 14
  assign full_width = block.settings.full_width | default: false
  assign modal_max_width = block.settings.modal_max_width | default: 680
-%}

<div class="fit-finder-button-wrapper fit-finder-button-wrapper--{{ block.settings.alignment }}">
  {%- if display_mode == 'modal' -%}
    <button type="button" class="fit-finder-button {{ style_class }}{% if full_width %} fit-finder-button--full{% endif %}" data-fit-finder-open data-fit-finder-url="{{ shop.url }}/apps/size-guide/fit-finder"
      style="--btn-color: {{ button_color }}; --btn-text: {{ text_color }}; --btn-radius: {{ border_radius }}px; --btn-padding: {{ button_padding }}px;">
      {{ link_text }}
    </button>
    <div class="fit-finder-modal hidden" data-fit-finder-modal role="dialog" aria-label="Fit finder">
      <div class="fit-finder-modal__overlay" data-fit-finder-close></div>
      <div class="fit-finder-modal__content">
        <button type="button" class="fit-finder-modal__close" data-fit-finder-close aria-label="{{ 'general.accessibility.close' | t }}">&times;</button>
        <div data-fit-finder-content class="fit-finder-modal__body">
          <p>{{ 'fit_finder.loading' | t }}</p>
        </div>
      </div>
    </div>
  {%- else -%}
    <a href="{{ shop.url }}/apps/size-guide/fit-finder" class="fit-finder-button {{ style_class }}{% if full_width %} fit-finder-button--full{% endif %}"
      style="--btn-color: {{ button_color }}; --btn-text: {{ text_color }}; --btn-radius: {{ border_radius }}px; --btn-padding: {{ button_padding }}px;">
      {{ link_text }}
    </a>
  {%- endif -%}
</div>

<style>
.fit-finder-button-wrapper { display: flex; margin: 12px 0; }
.fit-finder-button-wrapper--left { justify-content: flex-start; }
.fit-finder-button-wrapper--center { justify-content: center; }
.fit-finder-button-wrapper--right { justify-content: flex-end; }

.fit-finder-button {
  --btn-color: #008060;
  --btn-text: #ffffff;
  --btn-radius: 4px;
  --btn-padding: 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  font: inherit;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.2;
  text-decoration: none;
  cursor: pointer;
  border: none;
  border-radius: var(--btn-radius);
  padding: var(--btn-padding) calc(var(--btn-padding) * 1.4);
  transition: opacity 0.2s ease, transform 0.1s ease, box-shadow 0.2s ease;
}
.fit-finder-button--full { width: 100%; }
.fit-finder-button:hover { opacity: 0.92; }
.fit-finder-button:active { transform: translateY(1px); }

.fit-finder-button--primary {
  background-color: var(--btn-color);
  color: var(--btn-text);
  box-shadow: 0 1px 2px rgba(0,0,0,0.1);
}
.fit-finder-button--secondary {
  background-color: transparent;
  color: var(--btn-color);
  box-shadow: inset 0 0 0 2px var(--btn-color);
}
.fit-finder-button--link {
  background-color: transparent;
  color: var(--btn-color);
  text-decoration: underline;
  padding: 0;
}

.fit-finder-modal {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.fit-finder-modal.hidden { display: none; }
.fit-finder-modal__overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(2px);
}
.fit-finder-modal__content {
  position: relative;
  background: #fff;
  border-radius: 12px;
  max-width: {{ modal_max_width }}px;
  width: calc(100% - 32px);
  max-height: 90vh;
  overflow: auto;
  box-shadow: 0 10px 40px rgba(0,0,0,0.25);
}
.fit-finder-modal__close {
  position: absolute;
  top: 12px;
  right: 16px;
  background: none;
  border: none;
  font-size: 24px;
  cursor: pointer;
  line-height: 1;
  z-index: 1;
}
.fit-finder-modal__body { padding: 32px 24px 24px; }
</style>

<script src="{{ 'fit-finder.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Fit finder",
  "target": "section",
  "settings": [
    {
      "type": "select",
      "id": "display_mode",
      "label": "Display mode",
      "options": [
        { "value": "page", "label": "Link to page" },
        { "value": "modal", "label": "Open in modal" }
      ],
      "default": "page"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Button text",
      "default": "Find my size"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary outline" },
        { "value": "link", "label": "Text link" }
      ],
      "default": "primary"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#008060"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "default": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_padding",
      "label": "Button padding",
      "min": 8,
      "max": 30,
      "step": 2,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width button",
      "default": false
    },
    {
      "type": "range",
      "id": "modal_max_width",
      "label": "Modal max width",
      "min": 320,
      "max": 900,
      "step": 20,
      "default": 680,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    }
  ]
}
{% endschema %}
