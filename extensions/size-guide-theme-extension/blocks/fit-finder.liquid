{%- liquid
  assign link_text = block.settings.link_text | default: 'Find my size'
  assign style_class = 'fit-finder-button--' | append: block.settings.button_style
-%}

<div class="fit-finder-button-wrapper fit-finder-button-wrapper--{{ block.settings.alignment }}">
  <a href="{{ shop.url }}/apps/size-guide/fit-finder" class="fit-finder-button {{ style_class }}">
    {{ link_text }}
  </a>
</div>

<style>
.fit-finder-button-wrapper { display: flex; margin: 12px 0; }
.fit-finder-button-wrapper--left { justify-content: flex-start; }
.fit-finder-button-wrapper--center { justify-content: center; }
.fit-finder-button-wrapper--right { justify-content: flex-end; }

.fit-finder-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  font: inherit;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.2;
  text-decoration: none;
  cursor: pointer;
  border: none;
  border-radius: 4px;
  padding: 10px 18px;
  transition: opacity 0.2s ease, transform 0.1s ease, box-shadow 0.2s ease;
}
.fit-finder-button:hover { opacity: 0.92; }
.fit-finder-button:active { transform: translateY(1px); }

.fit-finder-button--primary {
  background-color: #008060;
  color: #ffffff;
  box-shadow: 0 1px 2px rgba(0,0,0,0.1);
}
.fit-finder-button--secondary {
  background-color: transparent;
  color: #008060;
  box-shadow: inset 0 0 0 2px #008060;
}
.fit-finder-button--link {
  background-color: transparent;
  color: inherit;
  text-decoration: underline;
  padding: 0;
}
</style>

{% schema %}
{
  "name": "Fit finder",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "link_text",
      "label": "Button text",
      "default": "Find my size"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary outline" },
        { "value": "link", "label": "Text link" }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    }
  ]
}
{% endschema %}
