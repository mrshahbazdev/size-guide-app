{%- liquid
  assign link_text = block.settings.link_text | default: 'Size guide'
  assign style_class = 'size-guide-button--' | append: block.settings.button_style
  assign button_color = block.settings.button_color | default: '#008060'
  assign text_color = block.settings.text_color | default: '#ffffff'
-%}

<div class="size-guide-button-wrapper size-guide-button-wrapper--{{ block.settings.alignment }}">
  <button type="button" class="size-guide-button {{ style_class }}" data-size-guide-open
    data-shop="{{ shop.permanent_domain }}"
    data-product-type="{{ product.type | escape }}"
    data-product-tags="{{ product.tags | join: ',' | escape }}"
    data-product-handle="{{ product.handle | escape }}"
    data-app-proxy-url="{{ shop.url }}/apps/size-guide"
    style="--btn-color: {{ button_color }}; --btn-bg: {{ button_color }}; --btn-text: {{ text_color }};"
    aria-label="{{ link_text }}">
    {{ link_text }}
  </button>
</div>

<div class="size-guide-modal hidden" data-size-guide-modal role="dialog" aria-label="Size guide">
  <div class="size-guide-modal__overlay" data-size-guide-close></div>
  <div class="size-guide-modal__content">
    <button type="button" class="size-guide-modal__close" data-size-guide-close aria-label="Close">&times;</button>
    <div data-size-guide-content class="size-guide-modal__body">
      <p>Loading size guide...</p>
    </div>
  </div>
</div>

<style>
.size-guide-button-wrapper { display: flex; margin: 12px 0; }
.size-guide-button-wrapper--left { justify-content: flex-start; }
.size-guide-button-wrapper--center { justify-content: center; }
.size-guide-button-wrapper--right { justify-content: flex-end; }

.size-guide-button {
  --btn-color: #008060;
  --btn-bg: #008060;
  --btn-text: #ffffff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  font: inherit;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.2;
  cursor: pointer;
  border: none;
  border-radius: 4px;
  padding: 10px 18px;
  transition: opacity 0.2s ease, transform 0.1s ease;
}
.size-guide-button:hover { opacity: 0.9; }
.size-guide-button:active { transform: translateY(1px); }

.size-guide-button--primary {
  background-color: var(--btn-bg);
  color: var(--btn-text);
}
.size-guide-button--secondary {
  background-color: transparent;
  color: var(--btn-color);
  box-shadow: inset 0 0 0 2px var(--btn-color);
}
.size-guide-button--link {
  background-color: transparent;
  color: var(--btn-color);
  text-decoration: underline;
  padding: 0;
}

.size-guide-modal {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.size-guide-modal.hidden { display: none; }
.size-guide-modal__overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
}
.size-guide-modal__content {
  position: relative;
  background: #fff;
  border-radius: 8px;
  max-width: 720px;
  width: calc(100% - 32px);
  max-height: 85vh;
  overflow: auto;
  box-shadow: 0 10px 40px rgba(0,0,0,0.25);
}
.size-guide-modal__close {
  position: absolute;
  top: 12px;
  right: 16px;
  background: none;
  border: none;
  font-size: 24px;
  cursor: pointer;
  line-height: 1;
  z-index: 1;
}
.size-guide-modal__body { padding: 32px 24px 24px; }
.size-guide__title { margin-top: 0; font-size: 20px; }
.size-guide__unit { color: #6b7280; margin-bottom: 12px; }
.size-guide__table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 14px; }
.size-guide__table th, .size-guide__table td { border: 1px solid #e5e7eb; padding: 10px 8px; text-align: center; }
.size-guide__table th { background: #f9fafb; font-weight: 600; }
.size-guide__table tr:nth-child(even) { background: #fafafa; }
</style>

<script src="{{ 'size-guide.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Size guide button",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Size guide"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary outline" },
        { "value": "link", "label": "Text link" }
      ],
      "default": "primary"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#008060"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    }
  ]
}
{% endschema %}
